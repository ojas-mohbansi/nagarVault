# NagarVault — mission baseline ignores (phase/00-mission-baseline, ADR-013)
# docker-compose*, per-service Dockerfiles, and legacy .env paths are NOT ignored:
# their deletion/audit is part of the mission record (ADR-004 as amended by ADR-013).

# --- secrets: plaintext secret material never enters git (invariant I-3) ---
*.plaintext.yaml
*.plain.yaml
jwt-secret*.yaml
kubeseal-*.yaml
*secret*plain*

# --- agent / tooling workspace ---
.freebuff/
agentic/tmp/
*.local.yaml
.k3d/
kubeconfig-*

# git-mirror payload is built at package time, never committed (contains a full copy
# of this repo's object database; committing it would fork history)
deploy/phases/02-gitops/git-mirror/payload/

# --- OS / editor noise ---
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# --- python (rebuild phases) ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- node (rebuild phases) ---
node_modules/
npm-debug.log*
.eslintcache

# --- next.js / vite build output ---
.next/
out/
dist/
